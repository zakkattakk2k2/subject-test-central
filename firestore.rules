rules_version = '2';

// ============================================================
// Firestore rules for project schedulemaker-c212c -- BOTH apps:
//   * Genius Schedule Maker (existing blocks, unchanged)
//   * Subject Test Central hosted SAT tests (stc* blocks)
//
// This file mirrors what is deployed in the Firebase console
// (Firestore Database -> Rules). Edit here, then paste the whole
// file there and Publish.
//
// When you add an admin in index.html's ACCESS CONTROL PANEL,
// add the same email to stcIsAdmin() below and re-publish.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Subject Test Central helpers =====
    function stcSignedIn(){ return request.auth != null; }
    function stcEmail(){ return request.auth.token.email.lower(); }
    function stcIsAdmin(){
      return stcSignedIn() && stcEmail() in [
        'zak.k@geniuspremium.com'
      ];
    }
    function stcIsGenius(){
      return stcSignedIn() && stcEmail().matches('.*@geniuspremium[.]com');
    }

    // Private per-user schedules: only the owner can read/write
    match /artifacts/{appId}/users/{userId}/schedules/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Shared schedules: owner OR an email on the share list can read.
    // Only the owner can delete. Anyone authenticated can create a doc
    // they own. Updates must preserve ownerId/ownerEmail.
    match /artifacts/{appId}/public/data/sharedSchedules/{scheduleId} {

      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || (resource.data.sharedWithEmails is list
            && request.auth.token.email in resource.data.sharedWithEmails)
      );

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        // Or you're a sharee editing the schedule data,
        // but you must not change ownerId/ownerEmail or the share list:
        || (
          request.auth.token.email in resource.data.sharedWithEmails
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.sharedWithEmails == resource.data.sharedWithEmails
        );

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // ===== Subject Test Central: hosted SAT tests =====

    // Who + when: a student may see (and live-query) only assignments
    // addressed to their own email; admins see and manage everything.
    match /artifacts/gpt-sat-formbuilder/public/data/assignments/{aid} {
      allow read: if stcIsAdmin() || (stcIsGenius() && resource.data.studentEmail == stcEmail());
      allow create, update, delete: if stcIsAdmin();
    }

    // The paper itself: the student can fetch it ONLY inside the
    // assignment's time window -- the server-side enforcement of
    // "login + specified time".
    match /artifacts/gpt-sat-formbuilder/public/data/assignmentBanks/{aid} {
      allow read: if stcIsAdmin() || (
        stcIsGenius()
        && get(/databases/$(database)/documents/artifacts/gpt-sat-formbuilder/public/data/assignments/$(aid)).data.studentEmail == stcEmail()
        && request.time >= get(/databases/$(database)/documents/artifacts/gpt-sat-formbuilder/public/data/assignments/$(aid)).data.start
        && request.time <= get(/databases/$(database)/documents/artifacts/gpt-sat-formbuilder/public/data/assignments/$(aid)).data.end
      );
      allow write: if stcIsAdmin();
    }

    // Marked results: a student can file results only under their own
    // email and read back their own (drives the "Submitted" status).
    // Only admins can change or remove results.
    match /artifacts/gpt-sat-formbuilder/public/data/results/{rid} {
      allow read: if stcIsAdmin() || (stcIsGenius() && resource.data.studentEmail == stcEmail());
      allow create: if stcIsAdmin() || (stcIsGenius() && request.resource.data.studentEmail == stcEmail());
      allow update, delete: if stcIsAdmin();
    }

    // Per-user private data for the form builder (issued-forms log).
    match /artifacts/gpt-sat-formbuilder/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
